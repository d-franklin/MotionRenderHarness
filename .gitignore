.npmrc

# Keys and certificates
*.pem
*.key
*.p12
*.pfx
*.keystore
id_rsa*
id_ed25519*

# Cloud service account keys
service-account*.json
gcloud-key*.json

# Logs
*.log
npm-debug.log*
