{
  "name": "motion-render-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Render a Motion page into a deterministic MP4 from one command.",
  "bin": {
    "mrh": "./bin/mrh.ts"
  },
  "scripts": {
    "mrh": "bun run bin/mrh.ts",
    "build:fixtures": "bun build fixtures/motion-page/app.ts --outdir fixtures/motion-page --target browser",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "puppeteer-core": "25.15.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "motion": "^14.5.0",
    "typescript": "^5.9.0"
  }
}
